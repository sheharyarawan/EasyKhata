<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="11dp"
    android:paddingHorizontal="16dp">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/itemIconCard"
        android:layout_width="50dp"
        android:layout_height="60dp"
        app:cardBackgroundColor="#F4F5F9"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/customerDetails">
        <ImageView
            android:id="@+id/customerIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@string/customer_3"
            android:src="@drawable/ic_box"
            android:visibility="visible"
            app:tint="#9EADB2"
            tools:ignore="ImageContrastCheck" />
    </com.google.android.material.card.MaterialCardView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/customerDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/itemIconCard"
        app:layout_constraintEnd_toStartOf="@id/itemMenu"
        app:layout_constraintTop_toTopOf="@id/itemIconCard"
        app:layout_constraintBottom_toBottomOf="@id/itemIconCard">
        <TextView
            android:id="@+id/itemType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#4D4D4D"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Biscuit"
            tools:ignore="VisualLintSystemUi" />
        <TextView
            android:id="@+id/itemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/itemType"
            tools:text="Rs 4000" />
        <TextView
            android:id="@+id/categoryUnit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9EADB2"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/itemPrice"
            app:layout_constraintTop_toBottomOf="@+id/itemType"
            app:layout_constraintVertical_bias="0.5"
            tools:ignore="TextContrastCheck"
            tools:text="per pcs" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:id="@+id/itemMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginEnd="4dp"
        android:paddingHorizontal="4dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_linear_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/itemIconCard"
        app:layout_constraintBottom_toBottomOf="@id/itemIconCard">
        <ImageView
            android:id="@+id/removeItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_minimize"
            android:layout_marginHorizontal="4dp"
            tools:ignore="ContentDescription">
        </ImageView>
        <TextView
            android:id="@+id/itemCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_0"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="8dp">
        </TextView>
        <ImageView
            android:id="@+id/addItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_maximize"
            android:layout_marginHorizontal="8dp"
            tools:ignore="ContentDescription">
        </ImageView>
    </LinearLayout>
    <View
        android:id="@+id/bottomDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="11dp"
        android:background="#86CFCFCF"
        app:layout_constraintTop_toBottomOf="@id/itemIconCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
