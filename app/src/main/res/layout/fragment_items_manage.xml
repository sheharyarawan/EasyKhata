<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.sales.ItemsManageFragment"
    tools:ignore="VisualLintSystemUi">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mereItemsToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:title="Mere items"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge.Emphasized"
        app:navigationIcon="@drawable/ic_back"
        app:menu="@menu/mere_items_menu"
        app:subtitle="Catalog mein 0"
        app:subtitleTextColor="#ACACAC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
    </com.google.android.material.appbar.MaterialToolbar>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialCardView13"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/lt_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mereItemsToolbar">
        <EditText
            android:id="@+id/itemSearchEt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:hint="@string/items_talash_karein"
            android:padding="12dp"
            tools:ignore="Autofill,TextFields">
        </EditText>
    </com.google.android.material.card.MaterialCardView>
    <View
        android:id="@+id/view18"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#B7C9C7C7"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/materialCardView13">
    </View>

    <LinearLayout
        android:id="@+id/emptyItemsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view18"
        app:layout_constraintVertical_bias="0.35000002">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/abhi_koi_item_nahi"
            android:textSize="20sp"
            android:textStyle="bold">
        </TextView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/salesItemAddKarein"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/black"
            android:paddingVertical="12dp"
            android:text="@string/pehla_item_add_karein"
            android:textSize="20sp"
            app:cornerRadius="10dp">
        </com.google.android.material.button.MaterialButton>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mereItemsRv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"

        tools:listitem="@layout/item_mere_items"
        app:layout_constraintBottom_toTopOf="@+id/nayaItemAddButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view18">
    </androidx.recyclerview.widget.RecyclerView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/nayaItemAddButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/naya_item"
        android:layout_margin="16dp"
        android:visibility="gone"
        android:backgroundTint="@color/black"
        android:textSize="20sp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    </com.google.android.material.button.MaterialButton>
</androidx.constraintlayout.widget.ConstraintLayout>