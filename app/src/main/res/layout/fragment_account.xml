<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.account.AccountFragment">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/accountToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
    </com.google.android.material.appbar.MaterialToolbar>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/editAccountCardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:contentPadding="16dp"
        app:cardBackgroundColor="#1A8D8D8D"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="@id/accountToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/accountToolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfile"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@color/white"
                android:padding="10dp"
                android:src="@drawable/ic_person"
                android:tint="@color/gray"
                android:scaleType="fitCenter"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
            <TextView
                android:id="@+id/tvAccountName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintStart_toEndOf="@id/ivProfile"
                app:layout_constraintEnd_toStartOf="@id/ivEdit"
                app:layout_constraintTop_toTopOf="@id/ivProfile"
                app:layout_constraintBottom_toTopOf="@id/tvAccountNumber"
                app:layout_constraintVertical_chainStyle="packed" />
            <TextView
                android:id="@+id/tvAccountNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/gray"
                android:textSize="18sp"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintStart_toEndOf="@id/ivProfile"
                app:layout_constraintEnd_toStartOf="@id/ivEdit"
                app:layout_constraintTop_toBottomOf="@id/tvAccountName"
                app:layout_constraintBottom_toBottomOf="@id/ivProfile" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivEdit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@color/white"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_edit"
                android:tint="@color/gray"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                tools:ignore="ImageContrastCheck" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <ImageView
        android:id="@+id/wasooliIv"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_initials"
        android:padding="5dp"
        android:src="@drawable/ic_calendar"
        app:layout_constraintEnd_toStartOf="@+id/visitingCardIv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editAccountCardView"
        app:tint="#FF5722"
        tools:ignore="ContentDescription,ImageContrastCheck">
    </ImageView>
    <ImageView
        android:id="@+id/visitingCardIv"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:background="@drawable/bg_initials"
        android:padding="5dp"
        android:src="@drawable/ic_card"
        app:layout_constraintBottom_toBottomOf="@+id/wasooliIv"
        app:layout_constraintEnd_toStartOf="@+id/cashBookIv"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/wasooliIv"
        app:layout_constraintTop_toTopOf="@+id/wasooliIv"
        app:tint="#3F51B5"
        tools:ignore="ContentDescription">
    </ImageView>
    <ImageView
        android:id="@+id/cashBookIv"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:background="@drawable/bg_initials"
        android:padding="5dp"
        android:src="@drawable/ic_cashbook"
        app:layout_constraintBottom_toBottomOf="@+id/visitingCardIv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/visitingCardIv"
        app:layout_constraintTop_toTopOf="@+id/visitingCardIv"
        app:tint="#D162AEEB"
        tools:ignore="ContentDescription,ImageContrastCheck">
    </ImageView>
    <TextView
        android:id="@+id/wasooliTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wasooli"
        android:textSize="18sp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/visitingCardTv"
        app:layout_constraintEnd_toEndOf="@+id/visitingCardIv"
        app:layout_constraintStart_toStartOf="@+id/visitingCardIv"
        app:layout_constraintTop_toTopOf="@+id/visitingCardTv">
    </TextView>
    <TextView
        android:id="@id/visitingCardTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/visiting_cards"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="@+id/wasooliIv"
        app:layout_constraintStart_toStartOf="@+id/wasooliIv"
        app:layout_constraintTop_toBottomOf="@+id/wasooliIv">
    </TextView>
    <TextView
        android:id="@+id/CashbookTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cashbook"
        android:textSize="18sp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/wasooliTv"
        app:layout_constraintEnd_toEndOf="@+id/cashBookIv"
        app:layout_constraintStart_toStartOf="@+id/cashBookIv"
        app:layout_constraintTop_toTopOf="@+id/wasooliTv">
    </TextView>
    <TextView
        android:id="@+id/karobarKiMaloomat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="40dp"
        android:gravity="center_vertical"
        android:drawablePadding="14dp"
        android:text="@string/karobar_ki_maloomat"
        android:textSize="20sp"
        app:drawableStartCompat="@drawable/ic_karobar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/visitingCardTv">
    </TextView>
    <View
        android:id="@+id/view10"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginTop="16dp"
        android:background="#9D9D9D"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/karobarKiMaloomat">
    </View>
    <TextView
        android:id="@+id/appSetting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:drawablePadding="14dp"
        android:gravity="center_vertical"
        android:text="@string/app_settings"
        android:textSize="20sp"
        app:drawableStartCompat="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view10">
    </TextView>
    <View
        android:id="@+id/view11"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginTop="16dp"
        android:background="#9D9D9D"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appSetting">
    </View>
    <TextView
        android:id="@+id/deleteItems"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:drawablePadding="14dp"
        android:gravity="center_vertical"
        android:text="@string/deleted_items"
        android:textSize="20sp"
        app:drawableStartCompat="@drawable/ic_delete"
        app:drawableTint="@color/gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view11">
    </TextView>
    <View
        android:id="@+id/view12"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginHorizontal="6dp"
        android:background="#9D9D9D"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/deleteItems">
    </View>
    <TextView
        android:id="@+id/rateEasyKhata"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:drawablePadding="14dp"
        android:gravity="center_vertical"
        android:text="@string/rate_easy_khata"
        android:textSize="20sp"
        app:drawableStartCompat="@drawable/ic_rate"
        app:drawableTint="@color/gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.187"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view12">
    </TextView>
</androidx.constraintlayout.widget.ConstraintLayout>