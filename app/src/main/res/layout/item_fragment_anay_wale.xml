<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="12dp">
    <TextView
        android:id="@+id/customerInitials"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_initials"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/udhaarItemDivider" />
    <TextView
        android:id="@+id/customerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintStart_toEndOf="@id/customerInitials"
        app:layout_constraintEnd_toStartOf="@id/customerAmount"
        app:layout_constraintTop_toTopOf="@id/customerInitials"
        app:layout_constraintBottom_toBottomOf="@id/customerInitials" />
    <TextView
        android:id="@+id/customerAmount"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/red"
        android:textSize="18sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/customerName"
        app:layout_constraintEnd_toStartOf="@id/customerDate"
        app:layout_constraintTop_toTopOf="@id/customerInitials"
        app:layout_constraintBottom_toBottomOf="@id/customerInitials" />
    <TextView
        android:id="@+id/customerDate"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:textColor="#4C4C4C"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/customerAmount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/customerInitials"
        app:layout_constraintBottom_toBottomOf="@id/customerInitials" />
    <View
        android:id="@+id/udhaarItemDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#ADADAD"
        app:layout_constraintTop_toBottomOf="@id/customerInitials"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
