<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.fragments.auth.OtpFragment"
    tools:ignore="VisualLintSystemUi">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/otpToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:title="SMS code darj karein"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge.Emphasized">
    </com.google.android.material.appbar.MaterialToolbar>
    <TextView
        android:id="@+id/numberToSendCode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/otpToolbar">
    </TextView>
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:weightSum="6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/numberToSendCode">
        <EditText
            android:id="@+id/otp1"
            style="@style/OtpBox"
            android:layout_weight="1"
            android:importantForAutofill="no"
            android:inputType="number"
            tools:ignore="LabelFor,SpeakableTextPresentCheck" />
        <EditText
            android:id="@+id/otp2"
            style="@style/OtpBox"
            android:layout_weight="1"
            android:autofillHints=""
            tools:ignore="LabelFor,SpeakableTextPresentCheck" />
        <EditText
            android:id="@+id/otp3"
            style="@style/OtpBox"
            android:layout_weight="1"
            tools:ignore="Autofill,LabelFor,SpeakableTextPresentCheck" />
        <EditText
            android:id="@+id/otp4"
            style="@style/OtpBox"
            android:layout_weight="1"
            tools:ignore="Autofill,LabelFor,SpeakableTextPresentCheck" />
        <EditText
            android:id="@+id/otp5"
            style="@style/OtpBox"
            android:layout_weight="1"
            tools:ignore="Autofill,LabelFor,SpeakableTextPresentCheck" />
        <EditText
            android:id="@+id/otp6"
            style="@style/OtpBox"
            android:layout_weight="1"
            android:importantForAutofill="no"
            tools:ignore="LabelFor,SpeakableTextPresentCheck" />
    </LinearLayout>
    <TextView
        android:id="@+id/textView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/code_nhi_aya_00_00_ke_baad_code_phir_se_bheja_ja_sakta_hai"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">
    </TextView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/smsPerBhejainButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/lt_gray"
        android:text="@string/sms_per_bhejain_2"
        android:textColor="@color/black"
        android:layout_marginTop="30dp"
        android:paddingVertical="12dp"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView">
    </com.google.android.material.button.MaterialButton>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/otpCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/smsPerBhejainButton">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="#A1FFFFFF"
            android:padding="16dp">
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/otpProgressBar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminate="true"
                app:indicatorColor="@color/black"
                app:indicatorSize="26dp"
                app:trackThickness="2dp" />
            <TextView
                android:id="@+id/otpProgressMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/login_code_validate_ho_raha_hai"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/otpErrorCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:visibility="gone"
        app:cardBackgroundColor="#CFCFCF"
        app:layout_constraintTop_toBottomOf="@+id/smsPerBhejainButton">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/otp_valid_nai_hai_dubaara_koshish_karein"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:background="#CFCFCF"
            android:padding="14dp">
        </TextView>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>