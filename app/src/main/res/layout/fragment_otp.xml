<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.fragments.auth.OtpFragment"
    tools:ignore="VisualLintSystemUi">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/otpToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:title="SMS code darj karein">
    </com.google.android.material.appbar.MaterialToolbar>
    <TextView
        android:id="@+id/numberToSendCode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/otpToolbar">
    </TextView>
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:weightSum="6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/numberToSendCode">
        <EditText
            android:id="@+id/otp1"
            style="@style/OtpBox"
            android:layout_weight="1"
            android:importantForAutofill="no"
            android:inputType="number"
            tools:ignore="LabelFor,SpeakableTextPresentCheck" />
        <EditText
            android:id="@+id/otp2"
            style="@style/OtpBox"
            android:layout_weight="1"
            android:autofillHints=""
            tools:ignore="LabelFor,SpeakableTextPresentCheck" />
        <EditText
            android:id="@+id/otp3"
            style="@style/OtpBox"
            android:layout_weight="1"
            tools:ignore="Autofill,LabelFor,SpeakableTextPresentCheck" />
        <EditText
            android:id="@+id/otp4"
            style="@style/OtpBox"
            android:layout_weight="1"
            tools:ignore="Autofill,LabelFor,SpeakableTextPresentCheck" />
        <EditText
            android:id="@+id/otp5"
            style="@style/OtpBox"
            android:layout_weight="1"
            tools:ignore="Autofill,LabelFor,SpeakableTextPresentCheck" />
        <EditText
            android:id="@+id/otp6"
            style="@style/OtpBox"
            android:layout_weight="1"
            android:importantForAutofill="no"
            tools:ignore="LabelFor,SpeakableTextPresentCheck" />
    </LinearLayout>
    <TextView
        android:id="@+id/textView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/code_nhi_aya_00_00_ke_baad_code_phir_se_bheja_ja_sakta_hai"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">
    </TextView>
    <com.google.android.material.chip.Chip
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="@color/lt_gray"
        android:text="@string/sms_per_bhejain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView">
    </com.google.android.material.chip.Chip>
</androidx.constraintlayout.widget.ConstraintLayout>