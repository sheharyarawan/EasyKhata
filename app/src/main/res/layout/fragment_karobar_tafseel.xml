<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.auth.KarobarTafseelFragment">
    <TextView
        android:id="@+id/textView47"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/karobar_ki_tafseelat"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="VisualLintSystemUi" />
    <TextView
        android:id="@+id/tvKarobarNaamLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:text="@string/apny_karobar_ka_naam_likhain"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView47" />
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardKarobarNaam"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="60dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/mid_gray"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvKarobarNaamLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <EditText
            android:id="@+id/etKarobarNaam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#39929292"
            android:hint="@string/karobar_ka_naam_2"
            android:inputType="textCapWords"
            android:padding="16dp"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textColorHint="@color/mid_gray"
            android:textSize="18sp"
            tools:ignore="Autofill,TextContrastCheck,VisualLintTextFieldSize" />
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardKarobarType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="18dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/mid_gray"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/cardKarobarNaam"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/tvKarobarType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#39929292"
            android:padding="16dp"
            android:text="@string/karobar_type_3"
            android:textColor="@color/mid_gray"
            android:textSize="18sp"
            app:drawableEndCompat="@drawable/ic_arrow_downward"
            app:drawableTint="@color/mid_gray"
            tools:ignore="TextContrastCheck" />
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/aagayBarheinButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="@color/mid_gray"
        android:paddingVertical="14dp"
        android:text="@string/aagay_barhein"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="TextContrastCheck,VisualLintButtonSize" />
</androidx.constraintlayout.widget.ConstraintLayout>
