<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
   android:layout_marginVertical="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/cardTopView"
            android:layout_width="100dp"
            android:layout_height="6dp"
            android:background="#ADADAD"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/textView10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/sort_by"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardTopView">
        </TextView>
        <ImageView
            android:id="@+id/closeSheet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_close"
            app:layout_constraintBottom_toBottomOf="@+id/textView10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView10"
            tools:ignore="ContentDescription">
        </ImageView>
        <View
            android:id="@+id/view4"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_margin="16dp"
            android:background="#ADADAD"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView10">
        </View>
        <TextView
            android:id="@+id/textView11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/sort_by"
            android:textColor="@color/gray"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view4"
            tools:ignore="TextContrastCheck">
        </TextView>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sortChipGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="10dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:singleLine="false"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView11">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipDefault"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                app:chipStartPadding="12dp"
                app:chipEndPadding="12dp"
                android:backgroundTint="#00FBFBFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#A9A9A9"
                android:textColor="#3D3D3D"
                android:text="@string/default_chip"
                android:textSize="17sp"
                android:paddingHorizontal="10dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipNewestFirst"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/newest_first"
                android:backgroundTint="#00FBFBFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#A9A9A9"
                android:textColor="#3D3D3D"
                android:textSize="17sp"
                app:chipStartPadding="12dp"
                app:chipEndPadding="12dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipOldestFirst"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/oldest_first"
                android:textSize="17sp"
                android:backgroundTint="#00FBFBFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#A9A9A9"
                android:textColor="#3D3D3D"
                app:chipStartPadding="12dp"
                app:chipEndPadding="12dp"
                android:paddingHorizontal="10dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipAmountHighToLow"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/amount_high_to_low"
                android:textSize="17sp"
                android:backgroundTint="#00FBFBFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#A9A9A9"
                android:textColor="#3D3D3D"
                android:paddingHorizontal="10dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipAmountLowToHigh"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/amount_low_to_high"
                android:textSize="17sp"
                android:backgroundTint="#00FBFBFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#A9A9A9"
                android:textColor="#3D3D3D"
                android:paddingHorizontal="10dp" />
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/expenseFilterButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:backgroundTint="@color/black"
            android:text="@string/filter_karein"
            android:textSize="18sp"
            app:cornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sortChipGroup"
            tools:ignore="VisualLintButtonSize">
        </com.google.android.material.button.MaterialButton>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>