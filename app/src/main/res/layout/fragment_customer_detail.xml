<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.customers.CustomerDetailFragment"
    android:background="@color/background"
    tools:ignore="VisualLintSystemUi">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/customerDetailToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_back"
        app:title="Dastgeer Furniture"
        app:subtitle="Customer since Oct 12, 2021"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/customer_detail_menu">
    </com.google.android.material.appbar.MaterialToolbar>
    <androidx.cardview.widget.CardView
        android:id="@+id/cardHisaabStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/lt_gray"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/customerDetailToolbar">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">
        <ImageView
            android:id="@+id/ivDropdown"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/circle_gray"
            android:contentDescription="Expand details"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_downward"
            android:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText,ImageContrastCheck,UseAppTint" />
        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Rs 0"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivDropdown"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />
        <TextView
            android:id="@+id/tvHisaabStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hisaab_clear_hai"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvAmount"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:id="@+id/reminderDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_calendar"
        app:layout_constraintEnd_toEndOf="@+id/reminderTv"
        app:layout_constraintStart_toStartOf="@+id/reminderTv"
        app:layout_constraintTop_toBottomOf="@+id/cardHisaabStatus"
        tools:ignore="ContentDescription,ImageContrastCheck">
    </ImageView>
    <TextView
        android:id="@+id/reminderTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:text="@string/tareekh_rakhein"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reminderDate">
    </TextView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSearch"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@id/cardSort"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/cardSort"
        app:strokeWidth="0dp">

        <EditText
            android:id="@+id/etSearchCustomer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textSize="16sp"
            tools:ignore="Autofill,LabelFor,SpeakableTextPresentCheck" />
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSort"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toEndOf="@id/cardSearch"
        app:layout_constraintTop_toBottomOf="@+id/reminderTv"
        app:strokeWidth="0dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/sort_customers"
            android:src="@drawable/ic_sort"
            tools:ignore="ImageContrastCheck" />
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPdf"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:cardCornerRadius="12dp"
        android:layout_marginStart="16dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@id/cardSort"
        app:layout_constraintStart_toEndOf="@+id/cardSort"
        app:layout_constraintTop_toTopOf="@id/cardSort"
        app:strokeWidth="0dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/export_pdf"
            android:src="@drawable/ic_pdf"
            tools:ignore="ImageContrastCheck" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="TIME"
        android:textColor="@color/gray"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardSearch"
        tools:ignore="HardcodedText,TextContrastCheck">
    </TextView>
    <TextView
        android:id="@+id/diyeTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="50dp"
        android:text="@string/diye"
        android:textColor="@color/gray"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/liyeTv"
        app:layout_constraintTop_toBottomOf="@+id/cardPdf"
        tools:ignore="TextContrastCheck">
    </TextView>
    <TextView
        android:id="@+id/liyeTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="50dp"
        android:text="@string/liye"
        android:textColor="@color/gray"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardPdf"
        tools:ignore="TextContrastCheck">
    </TextView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/customerDetailRv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:layout_marginBottom="131dp"
        android:background="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/liyeButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView7">
    </androidx.recyclerview.widget.RecyclerView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/liyeButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/green"
        android:paddingVertical="12dp"
        android:text="@string/maine_liye"
        android:textSize="19sp"
        app:cornerRadius="10dp"
        app:icon="@drawable/ic_arrow_downward"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/diyeButton"
        tools:ignore="VisualLintButtonSize">
    </com.google.android.material.button.MaterialButton>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/diyeButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/maine_diye"
        android:textSize="19sp"
        android:paddingVertical="12dp"
        android:backgroundTint="@color/red"
        app:cornerRadius="10dp"
        app:icon="@drawable/ic_arrow_upward"
        app:layout_constraintBottom_toBottomOf="@+id/liyeButton"
        app:layout_constraintEnd_toStartOf="@+id/liyeButton"
        app:layout_constraintHorizontal_bias="0.5"
        android:layout_margin="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/liyeButton"
        tools:ignore="VisualLintButtonSize">
    </com.google.android.material.button.MaterialButton>
</androidx.constraintlayout.widget.ConstraintLayout>