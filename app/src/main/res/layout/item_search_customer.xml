<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/itemSearchCustomerInitials"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            tools:text="Gv"
            android:background="@drawable/bg_initials"
            android:layout_marginVertical="6dp"
            android:textStyle="bold"
            android:textSize="16sp"
            android:padding="8dp"
            tools:ignore="VisualLintSystemUi">
        </TextView>
        <TextView
            android:id="@+id/itemSearchCustomerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_margin="6dp"
            tools:ignore="RtlSymmetry,VisualLintSystemUi">
        </TextView>
        <TextView
            android:id="@+id/itemSearchCustomerAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_margin="6dp">
        </TextView>
    </LinearLayout>
    <View
        android:id="@+id/view5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="8dp"
        android:background="#76ACACAC">
    </View>
</LinearLayout>