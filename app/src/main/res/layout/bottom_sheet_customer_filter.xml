<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:contentPaddingTop="16dp"
    app:contentPaddingBottom="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/cardTopView"
            android:layout_width="100dp"
            android:layout_height="6dp"
            android:background="#ADADAD"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/textView10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/filter_by"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardTopView">
        </TextView>
        <View
            android:id="@+id/view4"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_margin="16dp"
            android:background="#ADADAD"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView10">
        </View>
        <TextView
            android:id="@+id/textView11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/hisaab"
            android:textColor="@color/gray"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view4"
            tools:ignore="TextContrastCheck">
        </TextView>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sortChipGroupCustomer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="6dp"
            android:layout_margin="16dp"
            app:singleLine="false"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView11">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#00FBFBFB"
                android:checkable="true"
                android:paddingHorizontal="10dp"
                android:text="@string/all"
                android:textColor="#3D3D3D"
                android:textSize="17sp"
                app:chipEndPadding="12dp"
                app:chipStartPadding="12dp"
                app:chipStrokeColor="#A9A9A9"
                app:chipStrokeWidth="1dp"
                tools:ignore="DuplicateSpeakableTextCheck" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipHisaabClear"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/hisaab_clear_hai_2"
                android:backgroundTint="#00FBFBFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#A9A9A9"
                android:textColor="#3D3D3D"
                android:textSize="17sp"
                app:chipStartPadding="6dp"
                app:chipEndPadding="6dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipMaineDene"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/maine_dene_hain_2"
                android:textSize="17sp"
                android:backgroundTint="#00FBFBFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#A9A9A9"
                android:textColor="#3D3D3D"
                app:chipStartPadding="6dp"
                app:chipEndPadding="6dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipMaineLene"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/maine_lene_hain_2"
                android:textSize="17sp"
                android:backgroundTint="#00FBFBFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#A9A9A9"
                android:textColor="#3D3D3D"
                android:paddingHorizontal="10dp" />
        </com.google.android.material.chip.ChipGroup>
        <View
            android:id="@+id/view5"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_margin="16dp"
            android:background="#ADADAD"
            app:layout_constraintTop_toBottomOf="@id/sortChipGroupCustomer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
        </View>
        <TextView
            android:id="@+id/textView12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/type"
            android:textColor="@color/gray"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view5"
            tools:ignore="TextContrastCheck">
        </TextView>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCustomerType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:chipSpacingHorizontal="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView12"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipTypeAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/all"
                android:textSize="17sp"
                android:backgroundTint="#00FBFBFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#A9A9A9"
                android:textColor="#3D3D3D"
                android:paddingHorizontal="10dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipTypeCustomers"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/customers_2"
                android:textSize="17sp"
                android:backgroundTint="#00FBFBFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#A9A9A9"
                android:textColor="#3D3D3D"
                android:paddingHorizontal="10dp" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipTypeSuppliers"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/suppliers"
                android:textSize="17sp"
                android:backgroundTint="#00FBFBFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#A9A9A9"
                android:textColor="#3D3D3D"
                android:paddingHorizontal="10dp" />
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/customerFilterKareinButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            android:backgroundTint="@color/black"
            android:text="@string/filter_karein"
            android:textSize="18sp"
            app:cornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chipGroupCustomerType"
            tools:ignore="VisualLintButtonSize">
        </com.google.android.material.button.MaterialButton>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>