<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingTop="12dp">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/customerIconCard"
        android:layout_width="50dp"
        android:layout_height="60dp"
        app:cardBackgroundColor="#F4F5F9"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/customerDetails">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/customerInitials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#70777C"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="AZ" />

            <ImageView
                android:id="@+id/customerIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@string/customer_3"
                android:src="@drawable/ic_person"
                android:visibility="visible"
                app:tint="#9EADB2"
                tools:ignore="ImageContrastCheck" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/customerDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/customerIconCard"
        app:layout_constraintEnd_toStartOf="@id/saleAmount"
        app:layout_constraintTop_toTopOf="@id/customerIconCard"
        app:layout_constraintBottom_toBottomOf="@id/customerIconCard">
        <TextView
            android:id="@+id/customerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#4D4D4D"
            android:textSize="18sp"
            android:text="@string/walk_in_customer"
            android:textStyle="normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="VisualLintSystemUi" />
        <TextView
            android:id="@+id/invoiceNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9EADB2"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/customerName"/>

        <TextView
            android:id="@+id/invoiceDateTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9EADB2"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/invoiceNumber"
            tools:ignore="TextContrastCheck"
            tools:text="12 Oct · 3:13 PM" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/saleAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/saleMenu"
        app:layout_constraintTop_toTopOf="@id/customerIconCard"
        tools:text="Rs 80,000"
        tools:ignore="VisualLintSystemUi" />
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/paymentTypeCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#EAF6EE"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#C7E6D2"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toStartOf="@id/saleMenu"
        app:layout_constraintTop_toBottomOf="@id/saleAmount">
        <TextView
            android:id="@+id/paymentType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textColor="#357C50"
            android:textSize="14sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/saleMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/more_options"
        android:paddingVertical="6dp"
        android:src="@drawable/ic_more"
        app:layout_constraintBottom_toBottomOf="@id/customerIconCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/customerIconCard"
        app:tint="#9EADB2"
        tools:ignore="ImageContrastCheck" />
    <View
        android:id="@+id/bottomDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="#86CFCFCF"
        app:layout_constraintTop_toBottomOf="@id/customerIconCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
