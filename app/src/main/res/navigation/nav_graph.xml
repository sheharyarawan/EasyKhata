<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.easykhata.ui.fragments.customers.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_searchCustomerFragment"
            app:destination="@id/searchCustomerFragment" />
        <action
            android:id="@+id/action_homeFragment_to_addCustomerFragment"
            app:destination="@id/addCustomerFragment" />
        <action
            android:id="@+id/action_homeFragment_to_khataReportFragment"
            app:destination="@id/khataReportFragment" />
        <action
            android:id="@+id/action_homeFragment_to_addCustomerDetailFragment"
            app:destination="@id/addCustomerDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/salesFragment"
        android:name="com.example.easykhata.ui.fragments.sales.SalesFragment"
        android:label="fragment_sales"
        tools:layout="@layout/fragment_sales" >
        <action
            android:id="@+id/action_salesFragment_to_itemsManageFragment"
            app:destination="@id/itemsManageFragment" />
        <action
            android:id="@+id/action_salesFragment_to_saleDarjkareinFragment"
            app:destination="@id/saleDarjkareinFragment" />
    </fragment>
    <fragment
        android:id="@+id/accountFragment"
        android:name="com.example.easykhata.ui.fragments.account.AccountFragment"
        android:label="fragment_account"
        tools:layout="@layout/fragment_account" >
        <action
            android:id="@+id/action_accountFragment_to_visitingCardFragment"
            app:destination="@id/visitingCardFragment" />
        <action
            android:id="@+id/action_accountFragment_to_wasooliFragment"
            app:destination="@id/wasooliFragment" />
        <action
            android:id="@+id/action_accountFragment_to_cashbookFragment"
            app:destination="@id/cashbookFragment" />
        <action
            android:id="@+id/action_accountFragment_to_myDetailsFragment"
            app:destination="@id/myDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/searchCustomerFragment"
        android:name="com.example.easykhata.ui.fragments.customers.SearchCustomerFragment"
        android:label="fragment_search_customer"
        tools:layout="@layout/fragment_search_customer" />
    <fragment
        android:id="@+id/addCustomerFragment"
        android:name="com.example.easykhata.ui.fragments.customers.AddCustomerFragment"
        android:label="fragment_add_customer"
        tools:layout="@layout/fragment_add_customer" >
        <action
            android:id="@+id/action_addCustomerFragment_to_addCustomerDetailFragment"
            app:destination="@id/addCustomerDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/khataReportFragment"
        android:name="com.example.easykhata.ui.fragments.customers.KhataReportFragment"
        android:label="fragment_khata_report"
        tools:layout="@layout/fragment_khata_report" />
    <fragment
        android:id="@+id/addCustomerDetailFragment"
        android:name="com.example.easykhata.ui.fragments.customers.AddCustomerDetailFragment"
        android:label="fragment_add_customer_detail"
        tools:layout="@layout/fragment_add_customer_detail" />
    <fragment
        android:id="@+id/itemsManageFragment"
        android:name="com.example.easykhata.ui.fragments.sales.ItemsManageFragment"
        android:label="fragment_items_manage"
        tools:layout="@layout/fragment_items_manage" >
        <action
            android:id="@+id/action_itemsManageFragment_to_itemEditKareinFragment"
            app:destination="@id/itemEditKareinFragment" />
    </fragment>
    <fragment
        android:id="@+id/saleDarjkareinFragment"
        android:name="com.example.easykhata.ui.fragments.sales.SaleDarjkareinFragment"
        android:label="fragment_sale_darjkarein"
        tools:layout="@layout/fragment_sale_darjkarein" >
        <action
            android:id="@+id/action_saleDarjkareinFragment_to_itemEditKareinFragment"
            app:destination="@id/itemEditKareinFragment" />
        <action
            android:id="@+id/action_saleDarjkareinFragment_to_saleConfirmKareinFragment"
            app:destination="@id/saleConfirmKareinFragment" />
    </fragment>
    <fragment
        android:id="@+id/itemEditKareinFragment"
        android:name="com.example.easykhata.ui.fragments.sales.ItemEditKareinFragment"
        android:label="fragment_item_edit_karein"
        tools:layout="@layout/fragment_item_edit_karein" />
    <fragment
        android:id="@+id/saleConfirmKareinFragment"
        android:name="com.example.easykhata.ui.fragments.sales.SaleConfirmKareinFragment"
        android:label="fragment_sale_confirm_karein"
        tools:layout="@layout/fragment_sale_confirm_karein" />
    <fragment
        android:id="@+id/visitingCardFragment"
        android:name="com.example.easykhata.ui.fragments.account.VisitingCardFragment"
        android:label="fragment_visiting_card"
        tools:layout="@layout/fragment_visiting_card" >
        <action
            android:id="@+id/action_visitingCardFragment_to_karobarAddressFragment"
            app:destination="@id/karobarAddressFragment" />
        <action
            android:id="@+id/action_visitingCardFragment_to_karobarTypeFragment"
            app:destination="@id/karobarTypeFragment" />
    </fragment>
    <fragment
        android:id="@+id/wasooliFragment"
        android:name="com.example.easykhata.ui.fragments.account.WasooliFragment"
        android:label="fragment_wasooli"
        tools:layout="@layout/fragment_wasooli" />
    <fragment
        android:id="@+id/cashbookFragment"
        android:name="com.example.easykhata.ui.fragments.account.CashbookFragment"
        android:label="fragment_cashbook"
        tools:layout="@layout/fragment_cashbook" >
        <action
            android:id="@+id/action_cashbookFragment_to_cashDetailFragment"
            app:destination="@id/cashDetailFragment" />
        <action
            android:id="@+id/action_cashbookFragment_to_puranaRecordFragment"
            app:destination="@id/puranaRecordFragment" />
    </fragment>
    <fragment
        android:id="@+id/myDetailsFragment"
        android:name="com.example.easykhata.ui.fragments.account.MyDetailsFragment"
        android:label="fragment_my_details"
        tools:layout="@layout/fragment_my_details" />
    <fragment
        android:id="@+id/karobarAddressFragment"
        android:name="com.example.easykhata.ui.fragments.account.KarobarAddressFragment"
        android:label="fragment_karobar_address"
        tools:layout="@layout/fragment_karobar_address" />
    <fragment
        android:id="@+id/karobarTypeFragment"
        android:name="com.example.easykhata.ui.fragments.account.bottomSheets.KarobarTypeFragment"
        android:label="fragment_karobar_type"
        tools:layout="@layout/fragment_karobar_type" />
    <fragment
        android:id="@+id/anayWaleFragment"
        android:name="com.example.easykhata.ui.fragments.account.AnayWaleFragment"
        android:label="fragment_anay_wale"
        tools:layout="@layout/fragment_anay_wale" >
        <action
            android:id="@+id/action_anayWaleFragment_to_wasooliCustomerFragment"
            app:destination="@id/wasooliCustomerFragment" />
    </fragment>
    <fragment
        android:id="@+id/wasooliCustomerFragment"
        android:name="com.example.easykhata.ui.fragments.account.WasooliCustomerFragment"
        android:label="fragment_wasooli_customer"
        tools:layout="@layout/fragment_wasooli_customer" />
    <fragment
        android:id="@+id/cashDetailFragment"
        android:name="com.example.easykhata.ui.fragments.account.CashDetailFragment"
        android:label="fragment_cash_detail"
        tools:layout="@layout/fragment_cash_detail" />
    <fragment
        android:id="@+id/puranaRecordFragment"
        android:name="com.example.easykhata.ui.fragments.account.PuranaRecordFragment"
        android:label="fragment_purana_record"
        tools:layout="@layout/fragment_purana_record" />
</navigation>