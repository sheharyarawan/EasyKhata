<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_graph"
    app:startDestination="@id/signUpFragment">

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.easykhata.ui.fragments.auth.SignUpFragment"
        android:label="fragment_sign_up"
        tools:layout="@layout/fragment_sign_up" >
        <action
            android:id="@+id/action_signUpFragment_to_otpFragment"
            app:destination="@id/otpFragment" />
    </fragment>
    <fragment
        android:id="@+id/otpFragment"
        android:name="com.example.easykhata.ui.fragments.auth.OtpFragment"
        android:label="fragment_otp"
        tools:layout="@layout/fragment_otp" >
        <argument
            android:name="verificationId"
            app:argType="string" />

        <argument
            android:name="phoneNumber"
            app:argType="string" />

        <action
            android:id="@+id/action_otpFragment_to_karobarTafseelFragment"
            app:destination="@id/karobarTafseelFragment" />
    </fragment>
    <fragment
        android:id="@+id/karobarTafseelFragment"
        android:name="com.example.easykhata.ui.fragments.auth.KarobarTafseelFragment"
        android:label="fragment_karobar_tafseel"
        tools:layout="@layout/fragment_karobar_tafseel" >
        <action
            android:id="@+id/action_karobarTafseelFragment_to_karobarTypeFragment2"
            app:destination="@id/karobarTypeFragment2" />
        <argument
            android:name="phoneNumber"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/karobarTypeFragment2"
        android:name="com.example.easykhata.ui.fragments.account.bottomSheets.KarobarTypeFragment"
        android:label="fragment_karobar_type"
        tools:layout="@layout/fragment_karobar_type" />
</navigation>